# Copy to .env for local runs. Never commit .env.
# Max audio length accepted, in seconds (15 min).
YTCONV_MAX_DURATION_SECONDS=900
# MP3 quality in kbps (128, 192, 256 or 320).
YTCONV_AUDIO_BITRATE_KBPS=192
# Where converted files are written; deleted after YTCONV_RETENTION_SECONDS.
YTCONV_DOWNLOAD_DIR=/tmp/ytconv
YTCONV_RETENTION_SECONDS=3600
